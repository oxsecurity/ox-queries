query GetIssues($getIssuesInput: IssuesInput) {
  getIssues(getIssuesInput: $getIssuesInput) {
    issues {
      id
      issueId
      mainTitle
      created
      scanId
      createdAt
      compliance {
      standard
      control
      category
      description
    }
    }
    totalIssues
    totalFilteredIssues
    totalResolvedIssues
    offset
  }
}